# Copy this file to .env.local and fill in your own Supabase project's values.
# Never commit .env.local — it's already in .gitignore.

# Public (safe to expose to the browser) — from Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — used by scheduled jobs (health checks) and admin actions that
# must bypass RLS. NEVER expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: base URL used for generating sitemap.xml / OpenGraph metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
